const Sound = {
    ctx: null, master: null, noiseBuf: null, muted: loadNum('candySurvivorMute') === 1, last: {},
    init() {
        try {
            if (!this.ctx) {
                const AC = window.AudioContext || window.webkitAudioContext;
                this.ctx = new AC();
                this.master = this.ctx.createGain();
                this.master.gain.value = this.muted ? 0 : 1;
                this.master.connect(this.ctx.destination);
                const len = this.ctx.sampleRate * 0.5;
                this.noiseBuf = this.ctx.createBuffer(1, len, this.ctx.sampleRate);
                const d = this.noiseBuf.getChannelData(0);
                for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
            }
            if (this.ctx.state === 'suspended') this.ctx.resume();
        } catch (e) {}
    },
    setMuted(m) {
        this.muted = m; saveNum('candySurvivorMute', m ? 1 : 0);
        if (this.master) this.master.gain.value = m ? 0 : 1;
    },
    play(type, f0, f1, dur, vol = 0.1, key = type) {
        if (!this.ctx || this.muted) return;
        const nowMs = performance.now();
        if (nowMs - (this.last[key] || 0) < 45) return;   // 連打時の音割れ防止
        this.last[key] = nowMs;
        try {
            const t = this.ctx.currentTime;
            const gain = this.ctx.createGain();
            gain.gain.setValueAtTime(vol, t);
            gain.gain.exponentialRampToValueAtTime(0.001, t + dur);
            gain.connect(this.master);
            if (type === 'noise') {
                const src = this.ctx.createBufferSource(); src.buffer = this.noiseBuf;
                const f = this.ctx.createBiquadFilter(); f.type = 'bandpass';
                f.frequency.setValueAtTime(f0, t); f.frequency.linearRampToValueAtTime(f1 || f0, t + dur);
                src.connect(f); f.connect(gain);
                src.start(t); src.stop(t + dur);
            } else {
                const osc = this.ctx.createOscillator();
                osc.type = type;
                osc.frequency.setValueAtTime(f0, t);
                if (f1) osc.frequency.linearRampToValueAtTime(f1, t + dur);
                osc.connect(gain); osc.start(t); osc.stop(t + dur);
            }
        } catch (e) {}
    },
    bgmOn: false, step: 0, nextT: 0, bgmTimer: null,
    tone(type, f, t, dur, vol) {
        const o = this.ctx.createOscillator(), g = this.ctx.createGain();
        o.type = type; o.frequency.value = f;
        g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(vol, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        o.connect(g); g.connect(this.master); o.start(t); o.stop(t + dur + 0.05);
    },
    startBgm() {
        if (!this.ctx || this.bgmOn) return;
        this.bgmOn = true; this.step = 0; this.nextT = this.ctx.currentTime + 0.1;
        this.bgmTimer = setInterval(() => {
            const bass = [130.81, 110, 87.31, 98], sc = [523.25, 587.33, 659.25, 783.99, 880, 1046.5];
            while (this.nextT < this.ctx.currentTime + 0.4) {
                try {
                    const bar = Math.floor(this.step / 8) % 4, st = this.step % 8, t = this.nextT;
                    if (st % 4 === 0) this.tone('triangle', bass[bar], t, 0.5, 0.07);
                    if (st % 2 === 1) this.tone('sine', bass[bar] * 4, t, 0.12, 0.025);
                    if (Math.random() < 0.65) this.tone('sine', sc[Math.floor(Math.random() * sc.length)], t, 0.22, 0.04);
                } catch (e) {}
                this.nextT += 0.21; this.step++;
            }
        }, 100);
    },
    stopBgm() { clearInterval(this.bgmTimer); this.bgmOn = false; },
    shoot()  { this.play('triangle', 600, 300, 0.1, 0.04, 'shoot'); },
    laser()  { this.play('sawtooth', 900, 200, 0.18, 0.05, 'laser'); },
    hit()    { this.play('sawtooth', 150, 100, 0.1, 0.05, 'hit'); },
    hurt()   { this.play('square', 220, 80, 0.2, 0.1, 'hurt'); },
    gem()    { this.play('sine', 1200, 1500, 0.08, 0.04, 'gem'); },
    dash()   { this.play('noise', 1500, 300, 0.25, 0.25, 'dash'); },
    boom()   { this.play('sawtooth', 100, 20, 0.5, 0.2, 'boom'); },
    levelUp() {
        [[440,0],[554,100],[659,200]].forEach(([f, d]) => setTimeout(() => { Sound.last.lv = 0; Sound.play('square', f, f, d === 200 ? 0.4 : 0.2, 0.08, 'lv'); }, d));
    }
};

