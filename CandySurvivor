<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#ffd6e7">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<title>Candy Survivor</title>
<link href="https://fonts.googleapis.com/css2?family=Mochiy+Pop+One&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/phaser@3.60.0/dist/phaser.min.js" onerror="this.onerror=null;var s=document.createElement('script');s.src='phaser.min.js';document.head.appendChild(s);"></script>
<style>
    :root { --pink:#ff5fa2; --deep:#d63384; --soft:#ffe3ef; --ink:#7a2a55; --mint:#7fe0b0; --lemon:#ffe27a; }
    html, body { margin:0; height:100%; height:100dvh; width:100%; -webkit-touch-callout:none; background:#ffd6e7; overflow:hidden; font-family:'Mochiy Pop One','Hiragino Maru Gothic ProN','Rounded Mplus 1c','Hiragino Kaku Gothic ProN','Meiryo',sans-serif;
        user-select:none; -webkit-user-select:none; -webkit-tap-highlight-color:transparent; touch-action:none; overscroll-behavior:none; }
    canvas { display:block; touch-action:none; }
    #ui-layer { position:absolute; inset:0; z-index:10; pointer-events:none; }
    .pointer { pointer-events:auto; cursor:pointer; }
    .screen { position:absolute; inset:0; display:none; flex-direction:column; align-items:center; justify-content:center; pointer-events:auto; text-align:center; padding:16px; box-sizing:border-box; overflow:hidden; }

    #start-screen { display:flex; background:radial-gradient(circle at 20% 20%, #fff0f6 0, transparent 45%), radial-gradient(circle at 80% 80%, #d9f7ea 0, transparent 40%), linear-gradient(135deg,#ff9ac4,#ffd6ea 60%,#ffeaa7); }
    .float { position:absolute; font-size:34px; opacity:.55; animation:fl 7s ease-in-out infinite; pointer-events:none; }
    @keyframes fl { 0%,100%{ transform:translateY(0) rotate(-8deg);} 50%{ transform:translateY(-26px) rotate(10deg);} }
    h1 { position:relative; color:#fff; font-size:clamp(34px,9vw,60px); margin:0 0 14px; line-height:1.1; letter-spacing:2px;
        -webkit-text-stroke:2px var(--deep); paint-order:stroke fill; text-shadow:0 4px 0 var(--deep), 0 8px 12px rgba(214,51,132,.35); animation:bob 2.4s ease-in-out infinite; }
    h1 small { display:block; font-size:.42em; letter-spacing:6px; color:#fff6a8; }
    @keyframes bob { 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(-6px);} }
    #loading-msg { font-size:18px; color:#fff; text-shadow:1px 1px 0 var(--deep); }
    .btn { background:linear-gradient(#fff,#ffe9f3); color:var(--deep); border:4px solid var(--pink); padding:12px 40px; font-size:22px; border-radius:40px; box-shadow:0 6px 0 var(--deep); font-family:inherit; margin:6px; transition:transform .08s, box-shadow .08s; }
    .btn:active { transform:translateY(5px); box-shadow:0 1px 0 var(--deep); }
    .btn.sub { font-size:16px; padding:8px 26px; border-color:#9b7be0; color:#6b4bc2; box-shadow:0 5px 0 #6b4bc2; }
    #btn-start { display:none; }
    .help { margin-top:14px; color:#fff; font-size:12px; line-height:1.9; text-shadow:1px 1px 0 rgba(214,51,132,.9); }
    .chip { display:inline-block; background:#fff; color:var(--deep); border:3px solid var(--pink); border-radius:20px; padding:3px 14px; font-size:14px; margin:4px; }

    #hud { display:none; position:absolute; inset:0; }
    .top-info { position:absolute; top:calc(10px + env(safe-area-inset-top,0px)); left:50%; transform:translateX(-50%); background:rgba(255,255,255,.82); border:3px solid var(--pink); border-radius:22px;
        padding:4px 18px; color:var(--deep); font-size:15px; text-align:center; line-height:1.5; white-space:nowrap; box-shadow:0 3px 0 rgba(214,51,132,.4); }
    .top-btns { position:absolute; top:calc(8px + env(safe-area-inset-top,0px)); right:calc(10px + env(safe-area-inset-right,0px)); display:flex; gap:8px; }
    .mini-btn { width:40px; height:40px; border-radius:50%; background:#fff; border:3px solid var(--pink); display:flex; align-items:center; justify-content:center; font-size:18px; box-shadow:0 3px 0 var(--deep); }
    .bars { position:absolute; bottom:calc(20px + env(safe-area-inset-bottom,0px)); left:calc(18px + env(safe-area-inset-left,0px)); width:min(230px,46vw); background:rgba(255,255,255,.8); border:3px solid var(--pink); border-radius:18px; padding:8px 10px 4px; box-shadow:0 3px 0 rgba(214,51,132,.4); }
    .bar-bg { width:100%; height:14px; background:#ffe3ef; border:2px solid var(--pink); border-radius:8px; margin-bottom:5px; overflow:hidden; box-sizing:border-box; }
    .bar-fill { height:100%; width:100%; transition:width .15s; background-image:linear-gradient(45deg,rgba(255,255,255,.35) 25%,transparent 25%,transparent 50%,rgba(255,255,255,.35) 50%,rgba(255,255,255,.35) 75%,transparent 75%); background-size:16px 16px; }
    #hp-fill { background-color:#ff5fa2; } #exp-fill { background-color:#5ec8ff; width:0%; }
    .bar-label { font-size:12px; color:var(--ink); margin-bottom:2px; }
    #dash-btn { position:absolute; bottom:calc(24px + env(safe-area-inset-bottom,0px)); right:calc(24px + env(safe-area-inset-right,0px)); width:74px; height:74px; border:4px solid #fff; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:30px; background:#ff5fa2; box-shadow:0 5px 0 var(--deep); }
    #toast { position:absolute; top:22%; width:100%; text-align:center; font-size:30px; color:#fff; -webkit-text-stroke:2px var(--deep); paint-order:stroke fill; text-shadow:0 3px 0 var(--deep); opacity:0; transition:opacity .3s; pointer-events:none; }
    #combo { position:absolute; top:calc(74px + env(safe-area-inset-top,0px)); width:100%; text-align:center; font-size:24px; color:#fff6a8; -webkit-text-stroke:2px var(--deep); paint-order:stroke fill; text-shadow:0 3px 0 var(--deep); display:none; pointer-events:none; }
    #boss-bar { position:absolute; top:calc(62px + env(safe-area-inset-top,0px)); left:50%; transform:translateX(-50%); width:min(320px,70vw); display:none; text-align:center; font-size:12px; color:#fff; text-shadow:1px 1px 0 var(--deep),0 0 4px var(--deep); }
    #boss-bar .bar-bg { height:16px; background:#3a1f33; border-color:#fff; margin:2px 0 0; } #boss-fill { background-color:#b58cff; }

    #levelup-modal,#pause-screen,#gameover-screen,#shop-screen { background:rgba(122,42,85,.72); color:#fff; backdrop-filter:blur(2px); }
    .title2 { color:#fff6a8; font-size:38px; margin:0; -webkit-text-stroke:2px var(--deep); paint-order:stroke fill; text-shadow:0 4px 0 var(--deep); }
    .cards-box { display:flex; gap:12px; flex-wrap:wrap; justify-content:center; margin-top:20px; }
    .card { background:linear-gradient(#fff,#ffeaf3); color:var(--ink); width:136px; min-height:196px; border-radius:20px; border:4px solid var(--pink); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:8px; cursor:pointer; transition:.12s; box-sizing:border-box; gap:4px; box-shadow:0 6px 0 var(--deep); animation:pop .3s ease-out backwards; }
    .card:nth-child(2){ animation-delay:.08s; } .card:nth-child(3){ animation-delay:.16s; }
    @keyframes pop { from{ transform:scale(.3) rotate(-10deg); opacity:0; } }
    .card:hover { transform:translateY(-6px) scale(1.05); }
    .card .ic { font-size:42px; } .card .nm { font-size:14px; } .card .lv { font-size:12px; color:var(--deep); } .card .ds { font-size:11px; color:#a0607f; } .card .key { font-size:10px; color:#caa; }
    .result { font-size:18px; line-height:1.9; margin:12px 0 18px; }
    .shop-row { display:flex; align-items:center; gap:10px; background:#fff; color:var(--ink); border:3px solid var(--pink); border-radius:18px; padding:6px 12px; margin:6px 0; width:min(420px,88vw); box-sizing:border-box; text-align:left; font-size:13px; }
    .shop-row .ic { font-size:28px; } .shop-row .tx { flex:1; } .shop-row small { color:#a0607f; display:block; font-size:11px; }
    .shop-row button { font-family:inherit; background:var(--pink); color:#fff; border:none; border-radius:14px; padding:8px 12px; font-size:13px; box-shadow:0 3px 0 var(--deep); cursor:pointer; }
    .shop-row button:disabled { background:#ccc; box-shadow:0 3px 0 #999; cursor:default; }
    #debug-log { position:absolute; bottom:0; left:0; background:rgba(0,0,0,.6); color:#faa; font-size:11px; pointer-events:none; width:100%; }

    /* --- スマホ対応 --- */
    body { position:fixed; inset:0; }
    #ui-layer { position:fixed; }
    .screen { overflow-y:auto; touch-action:pan-y; justify-content:flex-start; -webkit-overflow-scrolling:touch; }
    .screen::before, .screen::after { content:''; margin:auto; }
    #combo { top:calc(108px + env(safe-area-inset-top,0px)); }
    .btn, .card, .mini-btn, #dash-btn { touch-action:manipulation; }
    @media (hover:none) { .card:hover { transform:none; } }
    @media (max-height:480px) {
        h1 { font-size:30px; margin-bottom:6px; } .help { margin-top:6px; line-height:1.5; }
        .btn { padding:8px 30px; font-size:18px; } .title2 { font-size:28px; }
        .result { margin:6px 0 10px; line-height:1.6; font-size:16px; }
        .card { min-height:150px; width:120px; } .cards-box { margin-top:10px; }
        .shop-row { margin:3px 0; } .float { display:none; }
    }
    @media (max-width:520px) and (orientation:portrait) {
        .cards-box { flex-direction:column; gap:10px; }
        .card { width:min(340px,88vw); min-height:0; flex-direction:row; text-align:left; gap:12px; padding:10px 14px; }
        .card .ic { font-size:36px; } .card .key { display:none; }
        .card .tx { display:flex; flex-direction:column; gap:2px; }
    }
    .tabs { display:flex; gap:6px; margin-bottom:8px; }
    .tab { font-family:inherit; border:3px solid var(--pink); background:#fff; color:var(--deep); border-radius:14px; padding:6px 10px; font-size:13px; }
    .tab.on { background:var(--pink); color:#fff; }
    #shop-list { max-height:48vh; overflow-y:auto; touch-action:pan-y; padding:2px; }
    @media (max-height:480px) { #shop-list { max-height:36vh; } }
    /* --- UI刷新 --- */
    :root { --glass:rgba(255,255,255,.74); }
    .btn { background:linear-gradient(180deg,#ff8cbc,#ff5fa2); color:#fff; border:none; border-radius:999px; padding:14px 46px; font-size:20px; letter-spacing:2px; text-shadow:0 2px 0 rgba(214,51,132,.5);
        box-shadow:0 8px 20px rgba(214,51,132,.35), inset 0 2px 0 rgba(255,255,255,.5); }
    .btn:active { transform:translateY(2px) scale(.98); box-shadow:0 3px 8px rgba(214,51,132,.3), inset 0 2px 0 rgba(255,255,255,.4); }
    .btn.sub { background:rgba(255,255,255,.88); color:#7a4bd1; border:2px solid #fff; font-size:15px; padding:10px 26px; text-shadow:none; box-shadow:0 6px 14px rgba(107,75,194,.25); }
    .chip, .top-info, .bars, .mini-btn { background:var(--glass); -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px); border:2px solid rgba(255,255,255,.95); box-shadow:0 6px 16px rgba(214,51,132,.2); }
    .chip { border-radius:999px; }
    .top-info { border-radius:18px; padding:5px 18px; } .mini-btn { width:42px; height:42px; }
    .bar-bg { height:12px; border:none; background:rgba(214,51,132,.14); border-radius:999px; } .bar-fill { border-radius:999px; background-image:none; }
    #hp-fill { background:linear-gradient(90deg,#ff8fb8,#ff5fa2); } #exp-fill { background:linear-gradient(90deg,#8fe3ff,#4db8ff); }
    #prog { position:absolute; top:0; left:0; right:0; height:5px; background:rgba(255,255,255,.35); } #prog i { display:block; height:100%; width:0; background:linear-gradient(90deg,#ffe27a,#ff5fa2); border-radius:0 4px 4px 0; }
    #dash-btn { border:3px solid #fff; box-shadow:0 8px 18px rgba(214,51,132,.4); }
    #levelup-modal, #pause-screen, #gameover-screen, #shop-screen { background:radial-gradient(circle at 50% 15%, rgba(255,130,185,.6), rgba(70,25,75,.9)); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); }
    .title2 { letter-spacing:3px; }
    .card { background:linear-gradient(180deg,#fff,#fff0f7); border:none; border-radius:22px; box-shadow:0 10px 24px rgba(0,0,0,.28), inset 0 0 0 2px #fff; }
    .shop-row { background:rgba(255,255,255,.95); border:none; border-radius:18px; box-shadow:0 4px 12px rgba(0,0,0,.18); }
    .shop-row button { background:linear-gradient(#ff8cbc,#ff5fa2); box-shadow:0 3px 0 var(--deep); }
    .pv { width:46px; height:46px; border-radius:13px; object-fit:cover; border:2px solid #fff; box-shadow:0 2px 6px rgba(0,0,0,.25); background:#ffe3ef; }
    .tab { border:none; background:rgba(255,255,255,.88); box-shadow:0 3px 8px rgba(0,0,0,.18); }
</style>
</head>
<body>

<div id="ui-layer">
    <div id="start-screen" class="screen" style="display:flex">
        <span class="float" style="left:8%;top:12%">🍭</span><span class="float" style="right:10%;top:16%;animation-delay:-2s">🍬</span>
        <span class="float" style="left:14%;bottom:14%;animation-delay:-4s">🧁</span><span class="float" style="right:12%;bottom:18%;animation-delay:-1s">🍩</span>
        <span class="float" style="left:48%;top:6%;animation-delay:-3s">⭐</span>
        <h1><small>★ SWEET ★</small>CANDY<br>SURVIVOR</h1>
        <div id="loading-msg">Loading...</div>
        <button id="btn-start" class="btn pointer">GAME START</button>
        <button id="btn-shop" class="btn sub pointer">🛍 おかしショップ</button>
        <div><span class="chip">🏆 BEST <span id="best-start">0</span></span><span class="chip">🍬 <span id="coins-start">0</span></span></div>
        <div class="chip" id="stage-chip"></div>
        <div class="help" id="help-txt">移動：WASD / 矢印キー / 画面ドラッグ<br>ダッシュ：Space / 💨（無敵）　ポーズ：P / Esc<br>攻撃は自動！ たおして キャンディを あつめよう</div>
    </div>

    <div id="hud">
        <div id="prog"><i id="prog-fill"></i></div>
        <div class="top-info">⏱ <span id="ui-time">0:00</span>　💀 <span id="ui-kills">0</span><br>⭐ <span id="ui-score">0</span></div>
        <div id="boss-bar"><div>👑 BOSS</div><div class="bar-bg"><div id="boss-fill" class="bar-fill"></div></div></div>
        <div id="combo"></div>
        <div class="top-btns">
            <div id="btn-sound" class="mini-btn pointer">🔊</div>
            <div id="btn-pause" class="mini-btn pointer">⏸</div>
        </div>
        <div class="bars">
            <div class="bar-label">♥ HP <span id="ui-hp">100/100</span></div>
            <div class="bar-bg"><div id="hp-fill" class="bar-fill"></div></div>
            <div class="bar-label">★ LV <span id="ui-lv">1</span></div>
            <div class="bar-bg"><div id="exp-fill" class="bar-fill"></div></div>
        </div>
        <div id="dash-btn" class="pointer">💨</div>
        <div id="toast"></div>
    </div>

    <div id="levelup-modal" class="screen">
        <h2 class="title2">LEVEL UP!</h2>
        <div class="cards-box" id="cards-container"></div>
    </div>

    <div id="pause-screen" class="screen">
        <h2 class="title2">PAUSE</h2>
        <div class="result" id="pause-info"></div>
        <button id="btn-resume" class="btn pointer">さいかい</button>
        <button id="btn-retire" class="btn sub pointer">リタイア</button>
    </div>

    <div id="gameover-screen" class="screen">
        <h2 id="go-title" class="title2" style="color:#ffb3d1">GAME OVER</h2>
        <div class="result" id="go-result"></div>
        <button id="btn-retry" class="btn pointer">もう一度</button>
        <button id="btn-go-shop" class="btn sub pointer">🛍 ショップへ</button>
    </div>

    <div id="shop-screen" class="screen">
        <h2 class="title2">おかしショップ</h2>
        <div class="chip" style="margin:10px">🍬 <span id="coins-shop">0</span></div>
        <div id="shop-tabs" class="tabs"></div>
        <div id="shop-list"></div>
        <button id="btn-shop-close" class="btn sub pointer">もどる</button>
    </div>

    <div id="debug-log"></div>
</div>

<script>
// ============================
// エラー表示
// ============================
window.onerror = function(msg, url, line) {
    document.getElementById('debug-log').innerText = `ERR: ${msg} (L:${line})`;
};

const $ = id => document.getElementById(id);
const cache = {};
function buzz(ms) { try { if (navigator.vibrate && !Sound.muted) navigator.vibrate(ms); } catch (e) {} }
function setText(id, v) { v = String(v); if (cache[id] !== v) { cache[id] = v; $(id).textContent = v; } }

// ============================
// ハイスコア・設定保存
// ============================
function loadNum(key) { try { return parseInt(localStorage.getItem(key)) || 0; } catch (e) { return 0; } }
function saveNum(key, v) { try { localStorage.setItem(key, v); } catch (e) {} }
let best = loadNum('candySurvivorBest');
const FONT = "'Mochiy Pop One', sans-serif";
const PERKS = [
    { id: 'hp',  icon: '❤️', name: 'ふわふわライフ',     text: '最大HP +10',      max: 10, base: 40 },
    { id: 'atk', icon: '🍰', name: 'あまあまパワー',     text: 'ダメージ +8%',    max: 10, base: 60 },
    { id: 'spd', icon: '👟', name: 'かるがるシューズ',   text: '移動速度 +8',     max: 10, base: 50 },
    { id: 'mag', icon: '🧲', name: 'ぺたぺたマグネット', text: '吸引範囲 +20',    max: 10, base: 40 },
    { id: 'crt', icon: '💥', name: 'ぴかぴか会心',       text: '会心率 +3%',      max: 10, base: 70 },
    { id: 'exp', icon: '📈', name: 'ぐんぐん成長',       text: '経験値 +8%',      max: 10, base: 70 },
    { id: 'arm', icon: '🛡️', name: 'あめコーティング',   text: '被ダメージ -1',   max: 8,  base: 90 },
    { id: 'cdr', icon: '⏱️', name: 'はやがけレシピ',     text: '攻撃間隔 -4%',    max: 10, base: 80 },
    { id: 'dsh', icon: '🌀', name: 'ひらりダッシュ',     text: 'ダッシュCT -0.12秒', max: 8, base: 60 },
    { id: 'cn',  icon: '🍬', name: 'キャンディ名人',     text: 'コイン +10%',     max: 10, base: 100 },
    { id: 'rev', icon: '👼', name: 'てんしのふっかつ',   text: '1回だけ復活',     max: 1,  base: 400 }
];
const perks = {}; PERKS.forEach(p => perks[p.id] = loadNum('csPerk_' + p.id));
let coins = loadNum('csCoins');
const WEAPS = [['candy', '🍬', 'キャンディ', 0], ['donut', '🍩', 'ドーナツ', 300], ['laser', '⚡', 'レーザー', 600], ['bomb', '💣', 'ボム', 600]];
const CHARMS = [
    { id: 'c1', icon: '🍀', name: 'よつばのクローバー', text: '会心率 +10%',  cost: 350,  fx: s => s.crit += .1 },
    { id: 'c2', icon: '🧸', name: 'くまさん',           text: '最大HP +30',   cost: 350,  fx: s => { s.maxHp += 30; s.hp += 30; } },
    { id: 'c3', icon: '🍪', name: 'クッキー',           text: '移動速度 +25', cost: 350,  fx: s => s.speed += 25 },
    { id: 'c6', icon: '💍', name: 'じしゃくリング',     text: '吸引範囲 +80', cost: 500,  fx: s => s.magnet += 80 },
    { id: 'c4', icon: '🔮', name: 'すいしょうだま',     text: '経験値 +25%',  cost: 600,  fx: s => s.expMul += .25 },
    { id: 'c5', icon: '👑', name: 'おうかん',           text: 'ダメージ +15%', cost: 900, fx: s => s.power += .15 },
    { id: 'c7', icon: '💎', name: 'ダイヤのリボン',     text: 'コイン +30%',  cost: 1200, fx: s => s.coinMul += .3 }
];
const STAGES = [
    { icon: '🍭', name: 'キャンディランド', text: 'ふつう',                 hp: 1,   spd: 1,    sp: 1,    coin: 1,   tint: 0xffffff, cost: 0 },
    { icon: '🌿', name: 'ミントの森',       text: '敵HP×1.3 / コイン×1.5', hp: 1.3, spd: 1.05, sp: 1.15, coin: 1.5, tint: 0xbfffd8, cost: 500 },
    { icon: '🍫', name: 'チョコ洞窟',       text: '敵HP×1.7 / コイン×2',   hp: 1.7, spd: 1.1,  sp: 1.3,  coin: 2,   tint: 0xe0a98a, cost: 1500 },
    { icon: '🌊', name: 'ソーダの海',       text: '敵HP×2.3 / コイン×3',   hp: 2.3, spd: 1.2,  sp: 1.5,  coin: 3,   tint: 0xa8d8ff, cost: 4000 }
];
const SKINS = [
    { icon: '🧁', name: 'ノーマル',     cost: 0,    f: 0xff8fc7, f2: 0xffb3da, w: 0xffd27f, t: 0 },
    { icon: '🍃', name: 'ミントチョコ', cost: 200,  f: 0x7fe0b0, f2: 0xb4f2d2, w: 0x8a5a44, t: 1 },
    { icon: '🫐', name: 'ブルーベリー', cost: 300,  f: 0x9a8cff, f2: 0xc2b8ff, w: 0xc9b8ff, t: 2 },
