// ============================
// Create
// ============================
function create() {
    S = this;
    const cam = this.cameras.main;

    bgTile = this.add.tileSprite(0, 0, cam.width, cam.height, 'bg0').setOrigin(0).setScrollFactor(0).setDepth(-10);
    this.scale.on('resize', gs => bgTile.setSize(gs.width, gs.height));

    player = this.physics.add.sprite(0, 0, 'p0').setDepth(10);
    player.body.setCircle(10, 10, 10);
    cam.startFollow(player, true, 0.15, 0.15);

    enemies = this.physics.add.group();
    bullets = this.physics.add.group();
    items   = this.physics.add.group();
    fxGfx   = this.add.graphics().setDepth(50);
    joyGfx  = this.add.graphics().setDepth(100).setScrollFactor(0);

    // 入力
    cursors = this.input.keyboard.createCursorKeys();
    wasd = this.input.keyboard.addKeys('W,A,S,D');
    this.input.keyboard.addKey('SPACE').on('down', tryDash);
    this.input.keyboard.on('keydown-P', () => state === 'playing' ? pauseGame() : resumeGame());
    this.input.keyboard.on('keydown-ESC', () => state === 'playing' ? pauseGame() : resumeGame());

    // 仮想ジョイスティック（タッチ/マウスドラッグ）
    this.input.addPointer(2);
    this.input.on('pointerdown', p => {
        if (state !== 'playing' || joy.active) return;
        Object.assign(joy, { active: true, id: p.id, ox: p.x, oy: p.y, x: 0, y: 0 });
    });
    this.input.on('pointermove', p => {
        if (!joy.active || p.id !== joy.id) return;
        const R = 60; let dx = p.x - joy.ox, dy = p.y - joy.oy, d = Math.hypot(dx, dy);
        if (d > R) { joy.ox += dx / d * (d - R); joy.oy += dy / d * (d - R); dx = p.x - joy.ox; dy = p.y - joy.oy; d = R; }
        joy.x = dx / R; joy.y = dy / R;
    });
    const joyEnd = p => { if (joy.active && p.id === joy.id) { joy.active = false; joy.x = joy.y = 0; } };
    this.input.on('pointerup', joyEnd);
    this.input.on('pointerupoutside', joyEnd);

    // 衝突
    this.physics.add.overlap(bullets, enemies, hitEnemy, null, this);
    this.physics.add.overlap(player, enemies, hitPlayer, null, this);
    this.physics.add.overlap(player, items, getItem, null, this);
    this.physics.add.collider(enemies, enemies);

    this.physics.pause();
    state = 'ready';
    $('loading-msg').style.display = 'none';
    $('btn-start').style.display = 'block';
}

// ============================
// Update
// ============================
function update(time, delta) {
    if (state !== 'playing') return;
    delta = Math.min(delta, 50);
    gameTime += delta;
    if (!finalSpawned && gameTime >= 900000) { finalSpawned = true; spawnBoss(true); }
    const dt = delta / 1000;
    const sec = gameTime / 1000;
    const cam = this.cameras.main;

    bgTile.setTilePosition(cam.scrollX, cam.scrollY);
    if (stats.regen) stats.hp = Math.min(stats.maxHp, stats.hp + stats.regen * dt);
    if (combo > 0 && gameTime > comboUntil) combo = 0;

    // --- 入力 ---
    let dx = 0, dy = 0;
    if (cursors.left.isDown  || wasd.A.isDown) dx -= 1;
    if (cursors.right.isDown || wasd.D.isDown) dx += 1;
    if (cursors.up.isDown    || wasd.W.isDown) dy -= 1;
    if (cursors.down.isDown  || wasd.S.isDown) dy += 1;
    if (joy.active) { dx = joy.x; dy = joy.y; }
    let len = Math.hypot(dx, dy);
    if (len > 1) { dx /= len; dy /= len; }
    if (len > 0.05) { lastDir.x = dx / len; lastDir.y = dy / len; }

    // --- ダッシュ ---
    if (dash.active && gameTime >= dash.until) { dash.active = false; invulUntil = Math.max(invulUntil, gameTime + 100); }
    if (dash.active) { player.setVelocity(lastDir.x * stats.speed * 2.5, lastDir.y * stats.speed * 2.5); if (fx.length < 300) fx.push({ kind: 'spark', x: player.x, y: player.y + 8, vx: 0, vy: 0, color: 0xffffff, t0: gameTime, dur: 300 }); }
    else player.setVelocity(dx * stats.speed, dy * stats.speed);
    updateDashUI();

    // --- 無敵中の見た目・ぽよぽよ歩き ---
    player.angle = (len > 0.05 || dash.active) ? Math.sin(gameTime / 70) * 9 : Math.sin(gameTime / 300) * 3;
    if (gameTime < invulUntil || dash.active) player.setAlpha(Math.floor(gameTime / 70) % 2 ? 0.45 : 0.95);
    else player.setAlpha(1);

    // --- 敵生成 ---
    const interval = Math.max(130, 700 - sec * 4) / ST().sp;
    if (gameTime - lastSpawn >= interval && enemies.countActive() < MAX_ENEMIES) {
        const n = 1 + Math.floor(sec / 90);
        for (let i = 0; i < n; i++) spawnEnemy();
        lastSpawn = gameTime;
    }
    if (gameTime >= nextBossAt && nextBossAt < 900000) { spawnBoss(); nextBossAt += 60000; }

    // --- 敵更新（破壊されても安全なようコピーを使う） ---
    const list = enemies.getChildren().slice();
    for (const e of list) {
        if (!e.active) continue;
        this.physics.moveToObject(e, player, e.speed);
        e.angle = Math.sin(gameTime / 130 + e.ph) * 7;
        if (e.flashUntil && gameTime > e.flashUntil) { e.flashUntil = 0; e.clearTint(); if (e.baseTint) e.setTint(e.baseTint); }
    }

    // --- 弾の寿命 ---
    bullets.getChildren().slice().forEach(b => { if (gameTime - b.born > 1400) b.destroy(); });

    // --- アイテム吸引 ---
    items.getChildren().forEach(it => {
        if (!it.active) return;
        if (it.pulled || Phaser.Math.Distance.Between(player.x, player.y, it.x, it.y) < stats.magnet) {
            it.pulled = true; this.physics.moveToObject(it, player, 450);
        }
    });
    if (items.countActive() > 400) items.getChildren()[0].destroy();

    // --- 武器 ---
    // キャンディ
    const c = W.candy();
    if (gameTime >= weapons.candy.last + c.cd) {
        const t = getClosest(list, 600);
        if (t) {
            const base = Math.atan2(t.y - player.y, t.x - player.x);
            for (let i = 0; i < c.count; i++) {
                const a = base + (i - (c.count - 1) / 2) * 0.2;
                const b = bullets.create(player.x, player.y, 'bullet');
                b.born = gameTime; b.pierce = c.pierce; b.dmg = c.dmg; b.hit = new Set();
                this.physics.velocityFromRotation(a, 500, b.body.velocity); b.rotation = a;
            }
            Sound.shoot();
            weapons.candy.last = gameTime;
        }
    }
    updateDonuts(list, dt);
    if (weapons.laser.lv > 0) {
        const l = W.laser();
        if (gameTime >= weapons.laser.last + l.cd && fireLaser(list, l)) weapons.laser.last = gameTime;
    }
    if (weapons.bomb.lv > 0) {
        const b = W.bomb();
        if (gameTime >= weapons.bomb.last + b.cd) { dropBombs(list, b); weapons.bomb.last = gameTime; }
    }
    updateFx(list);

    // --- ジョイスティック描画 ---
    joyGfx.clear();
    if (joy.active) {
        joyGfx.lineStyle(3, 0xffffff, 0.45); joyGfx.strokeCircle(joy.ox, joy.oy, 60);
        joyGfx.fillStyle(0xffffff, 0.55); joyGfx.fillCircle(joy.ox + joy.x * 60, joy.oy + joy.y * 60, 22);
    }

    // --- ボスHP・コンボ表示 ---
    const bb = $('boss-bar');
    if (bossRef && bossRef.active) { bb.style.display = 'block'; $('boss-fill').style.width = Math.max(0, bossRef.hp / bossRef.maxHp * 100) + '%'; }
    else bb.style.display = 'none';
    const cb = $('combo');
    if (combo >= 3) { cb.style.display = 'block'; setText('combo', `COMBO ×${combo}`); } else { cb.style.display = 'none'; cache.combo = ''; }

    updateHud();
}

// ============================
// 武器処理
// ============================
function updateDonuts(list, dt) {
    const w = weapons.donut, p = W.donut();
    while (donutSprites.length < p.count) donutSprites.push(S.add.image(player.x, player.y, 'donut').setDepth(8));
    while (donutSprites.length > p.count) donutSprites.pop().destroy();
    if (p.count === 0) return;
    w.angle += dt * p.speed;
    donutSprites.forEach((s, i) => {
        const a = w.angle + i * Math.PI * 2 / p.count;
        s.setPosition(player.x + Math.cos(a) * p.radius, player.y + Math.sin(a) * p.radius);
        s.rotation += dt * 6;
        for (const e of list) {
            if (!e.active || gameTime < (e.donutT || 0)) continue;
            if (Phaser.Math.Distance.Between(s.x, s.y, e.x, e.y) < p.hitR + e.r) {
                e.donutT = gameTime + 450;
                damageEnemy(e, p.dmg);
            }
        }
    });
}

function fireLaser(list, p) {
    const t = getClosest(list, 700);
    if (!t) return false;
    const base = Math.atan2(t.y - player.y, t.x - player.x);
    (p.both ? [base, base + Math.PI] : [base]).forEach(a => {
        const ux = Math.cos(a), uy = Math.sin(a);
        fx.push({ kind: 'beam', x1: player.x, y1: player.y, x2: player.x + ux * p.len, y2: player.y + uy * p.len, t0: gameTime, dur: 250, w: 10 });
        for (const e of list) {
            if (!e.active) continue;
            const vx = e.x - player.x, vy = e.y - player.y;
            const proj = vx * ux + vy * uy, perp = Math.abs(vx * uy - vy * ux);
            if (proj > -e.r && proj < p.len && perp < e.r + 8) damageEnemy(e, p.dmg);
        }
    });
    Sound.laser();
    return true;
}

function dropBombs(list, p) {
    const alive = list.filter(e => e.active && Phaser.Math.Distance.Between(player.x, player.y, e.x, e.y) < 500);
    for (let i = 0; i < p.count; i++) {
        let x, y;
        if (alive.length) { const e = Phaser.Utils.Array.GetRandom(alive); x = e.x; y = e.y; }
        else { x = player.x + Phaser.Math.Between(-200, 200); y = player.y + Phaser.Math.Between(-200, 200); }
        fx.push({ kind: 'bomb', x, y, r: p.radius, t0: gameTime, fuse: p.fuse, dmg: p.dmg });
    }
}

function updateFx(list) {
    fxGfx.clear();
    for (let i = fx.length - 1; i >= 0; i--) {
        const f = fx[i], t = gameTime - f.t0;
        if (f.kind === 'beam') {
            const k = 1 - t / f.dur;
            if (k <= 0) { fx.splice(i, 1); continue; }
            fxGfx.lineStyle(f.w * k + 2, 0x00ffff, k); fxGfx.lineBetween(f.x1, f.y1, f.x2, f.y2);
            fxGfx.lineStyle((f.w * k + 2) / 3, 0xffffff, k); fxGfx.lineBetween(f.x1, f.y1, f.x2, f.y2);
        } else if (f.kind === 'bomb') {
            if (t >= f.fuse) {
                fx.splice(i, 1);
                Sound.boom(); S.cameras.main.shake(100, 0.008);
                for (const e of list) {
                    if (e.active && Phaser.Math.Distance.Between(f.x, f.y, e.x, e.y) < f.r + e.r) damageEnemy(e, f.dmg);
                }
                fx.push({ kind: 'boom', x: f.x, y: f.y, r: f.r, t0: gameTime, dur: 300, color: 0xffa500 });
                continue;
            }
            const k = t / f.fuse;
            fxGfx.lineStyle(3, 0xff3355, 0.8); fxGfx.strokeCircle(f.x, f.y, f.r);
            fxGfx.fillStyle(0xff3355, 0.1 + 0.25 * k); fxGfx.fillCircle(f.x, f.y, f.r * k);
            fxGfx.fillStyle(0x333333, 1); fxGfx.fillCircle(f.x, f.y, 8); fxGfx.fillStyle(0xff0000, 1); fxGfx.fillCircle(f.x, f.y, 3);
        } else if (f.kind === 'txt') {
            const k = t / f.dur;
            if (k >= 1) { f.obj.destroy(); txtCount--; fx.splice(i, 1); continue; }
            f.obj.setPosition(f.x, f.y - 30 * k).setAlpha(1 - k * k);
        } else if (f.kind === 'spark') {
            const k = t / f.dur;
            if (k >= 1) { fx.splice(i, 1); continue; }
            const sc = t / 1000;
            fxGfx.fillStyle(f.color, 1 - k); fxGfx.fillCircle(f.x + f.vx * sc, f.y + f.vy * sc + 220 * sc * sc, 4 * (1 - k) + 1);
        } else if (f.kind === 'boom') {
            const k = t / f.dur;
            if (k >= 1) { fx.splice(i, 1); continue; }
            fxGfx.fillStyle(f.color, 0.55 * (1 - k)); fxGfx.fillCircle(f.x, f.y, f.r * (0.4 + 0.6 * k));
        }
    }
}

// ============================
// 敵・戦闘ロジック
// ============================
function spawnEnemy() {
    const cam = S.cameras.main;
    const r = Math.hypot(cam.width, cam.height) / 2 / cam.zoom + 40;
    const a = Math.random() * Math.PI * 2;
    const sec = gameTime / 1000;
    let hp = Math.ceil((2 + Math.floor(sec / 30) + Math.floor((stats.lv - 1) / 3)) * ST().hp * (1 + sec / 120));
    let spd = (90 + Math.min(70, sec / 4)) * ST().spd, exp = 1, tex = 'gummy' + Phaser.Math.Between(1, 3), rad = 14, off = [4, 6];

    const roll = Math.random();
    if (sec >= 90 && roll < 0.15)      { tex = 'tank'; hp *= 3; spd *= 0.7; exp = 3; rad = 20; off = [4, 4]; }
    else if (sec >= 30 && roll < 0.35) { tex = 'runner'; hp = Math.max(1, Math.ceil(hp * 0.5)); spd *= 1.6; rad = 11; off = [6, 2]; }

    const e = enemies.create(player.x + Math.cos(a) * r, player.y + Math.sin(a) * r, tex);
    e.setDepth(5);
    e.body.setCircle(rad, off[0], off[1]);
    Object.assign(e, { hp, maxHp: hp, speed: spd, dmg: Math.round(10 + sec / 40), exp, r: rad, boss: false, ph: Math.random() * 6.28 });
}

function spawnBoss(fin) {
    bossCount++;
    const a = Math.random() * Math.PI * 2;
    const r = Math.hypot(S.cameras.main.width, S.cameras.main.height) / 2 + 80;
    const e = enemies.create(player.x + Math.cos(a) * r, player.y + Math.sin(a) * r, 'boss');
    e.setDepth(6).setScale(fin ? 2.4 : 1.3); if (fin) { e.baseTint = 0xff9aae; e.setTint(0xff9aae); }
    e.body.setCircle(42, 6, 6);
    const hp = fin ? Math.round(1800 * ST().hp) : Math.round((40 + 40 * bossCount) * ST().hp * (1 + gameTime / 240000));
    Object.assign(e, { hp, maxHp: hp, speed: fin ? 70 : 50, dmg: fin ? 35 : 20 + Math.round(gameTime / 60000), exp: 5, r: 42 * (fin ? 2.4 : 1.3), boss: true, final: !!fin, ph: 0 });
    bossRef = e;
    Sound.boom();
    toast(fin ? '👑 最終ボス出現！' : '⚠ BOSS 出現！');
}

function getClosest(list, maxDist) {
    let t = null, min = maxDist;
    for (const e of list) {
        if (!e.active) continue;
        const d = Phaser.Math.Distance.Between(player.x, player.y, e.x, e.y);
        if (d < min) { min = d; t = e; }
    }
    return t;
}

function hitEnemy(bullet, enemy) {
    if (!bullet.active || !enemy.active || bullet.hit.has(enemy)) return;
    bullet.hit.add(enemy);
    damageEnemy(enemy, bullet.dmg);
    if (bullet.pierce-- <= 0) bullet.destroy();
}

const SPARK = [0xff7aa8, 0xffe27a, 0x7fe0b0, 0x7fd8ff, 0xb58cff, 0xffffff];
function popText(x, y, str, color = '#ffffff') {
    if (fx.length > 300 || txtCount >= 30) return;
    txtCount++;
    const o = S.add.text(x, y, str, { fontFamily: FONT, fontSize: '16px', color, stroke: '#7a2a55', strokeThickness: 4 }).setOrigin(0.5).setDepth(60);
    fx.push({ kind: 'txt', obj: o, x, y, t0: gameTime, dur: 600 });
}

function damageEnemy(e, dmg) {
    if (!e.active) return;
    const cr = Math.random() < stats.crit; if (cr) dmg *= 1.8;
    e.hp -= dmg;
    e.setTintFill(0xffffff); e.flashUntil = gameTime + 70;
    popText(e.x, e.y - e.r, (cr ? '💥' : '') + String(Math.max(1, Math.round(dmg))), cr || e.boss ? '#ffe27a' : '#ffffff');
    if (e.hp > 0) return;

    if (e.boss) {
        for (let i = 0; i < 3; i++) dropItem(e.x + Phaser.Math.Between(-25, 25), e.y + Phaser.Math.Between(-25, 25), 'gem', 5);
        dropItem(e.x, e.y, 'heart', 0);
        S.cameras.main.shake(300, 0.012); Sound.boom();
    } else if (Math.random() < 0.04) dropItem(e.x, e.y, 'heart', 0);
    else dropItem(e.x, e.y, 'gem', e.exp);

    if (fx.length < 350) for (let i = 0; i < (e.boss ? 18 : 6); i++) {
        const an = Math.random() * 6.28, sp = 60 + Math.random() * 120;
        fx.push({ kind: 'spark', x: e.x, y: e.y, vx: Math.cos(an) * sp, vy: Math.sin(an) * sp - 60, color: Phaser.Utils.Array.GetRandom(SPARK), t0: gameTime, dur: 450 });
    }
    e.destroy();
    Sound.hit();
    stats.kills++;
    combo++; comboUntil = gameTime + 2000;
    score += Math.round((e.boss ? 200 : 10) * (1 + Math.floor(combo / 10) * 0.25));
    if (e.final) gameOver('win');
}

function dropItem(x, y, kind, value) {
    const i = items.create(x, y, kind);
    i.setDepth(3); i.kind = kind; i.value = value; i.pulled = false;
    if (kind === 'gem' && value > 1) i.setScale(1 + Math.min(0.8, value * 0.15));
}

function hitPlayer(p, e) {
    if (state !== 'playing' || gameTime < invulUntil || dash.active) return;
    const dm = Math.max(1, e.dmg - stats.armor); stats.hp -= dm;
    invulUntil = gameTime + 450;
    combo = 0;
    Sound.hurt(); buzz(40);
    S.cameras.main.shake(150, 0.008);
    popText(player.x, player.y - 26, '-' + dm, '#ff4d6d');
    updateHud();
    if (stats.hp > 0) return;
    if (perks.rev && !revived) {
        revived = true; stats.hp = Math.ceil(stats.maxHp / 2); invulUntil = gameTime + 2500;
        enemies.getChildren().slice().forEach(en => { if (en.active && !en.boss && Phaser.Math.Distance.Between(player.x, player.y, en.x, en.y) < 320) damageEnemy(en, 9999); });
        fx.push({ kind: 'boom', x: player.x, y: player.y, r: 320, t0: gameTime, dur: 500, color: 0xfff6a8 });
        Sound.levelUp(); toast('👼 ふっかつ！'); updateHud();
    } else gameOver();
}

function getItem(p, item) {
    if (!item.active || state !== 'playing') return;
    if (item.kind === 'heart') stats.hp = Math.min(stats.maxHp, stats.hp + 30);
    else stats.exp += item.value * stats.expMul;
    Sound.gem();
    item.destroy();
    updateHud();
    checkLevelUp();
}

// ============================
// ダッシュ
// ============================
function tryDash() {
    if (state !== 'playing' || gameTime < dash.readyAt) return;
    dash.active = true; dash.until = gameTime + 220; dash.readyAt = gameTime + dash.cd;
    Sound.dash();
}

let dashUiKey = '';
function updateDashUI() {
    const remain = Math.max(0, dash.readyAt - gameTime) / dash.cd;
    const key = String(Math.round(remain * 20));
    if (key === dashUiKey) return;
    dashUiKey = key;
    const b = $('dash-btn');
    if (remain <= 0) { b.style.background = '#ff1493'; b.style.opacity = 1; }
    else { b.style.background = `conic-gradient(#ff1493 ${(1 - remain) * 360}deg, #444 0)`; b.style.opacity = 0.7; }
}

// ============================
// レベルアップ
// ============================
function checkLevelUp() {
    if (state !== 'playing' || stats.exp < stats.next) return;
    stats.exp -= stats.next;
    stats.lv++;
    for (let i = 0; i < 18; i++) fx.push({ kind: 'spark', x: player.x, y: player.y, vx: Math.cos(i / 18 * 6.28) * 160, vy: Math.sin(i / 18 * 6.28) * 160 - 40, color: SPARK[i % 6], t0: gameTime, dur: 600 });
    stats.next = Math.floor(stats.next * 1.3) + 3;
    updateHud();

    const pool = UPGRADES.filter(u => u.lv() < u.max && (u.id !== 'heal' || stats.hp < stats.maxHp));
    for (let i = pool.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [pool[i], pool[j]] = [pool[j], pool[i]]; }
    const picks = pool.slice(0, 3);
    if (!picks.length) { score += 100; checkLevelUp(); return; }

    state = 'levelup';
    S.physics.pause();
    joy.active = false; joy.x = joy.y = 0;
    Sound.levelUp(); buzz(25);

    const box = $('cards-container');
    box.innerHTML = '';
    picks.forEach((u, idx) => {
        const cur = u.lv();
        const div = document.createElement('div');
        div.className = 'card';
        const mk = (cls, txt) => { const d = document.createElement('div'); d.className = cls; d.textContent = txt; div.appendChild(d); };
        mk('ic', u.icon);
        const tx = document.createElement('div'); tx.className = 'tx'; div.appendChild(tx);
        const mk2 = (cls, txt) => { const d = document.createElement('div'); d.className = cls; d.textContent = txt; tx.appendChild(d); };
        mk2('nm', u.name);
        if (u.max < 99) mk2('lv', cur === 0 && ['donut', 'laser', 'bomb'].includes(u.id) ? 'NEW!' : `Lv ${cur} → ${cur + 1}`);
        mk2('ds', u.text); mk('key', `[${idx + 1}]`);
        div.onclick = () => {
            if (state !== 'levelup') return;
            u.apply();
            $('levelup-modal').style.display = 'none';
            state = 'playing';
            S.physics.resume();
            updateHud();
            checkLevelUp();   // 経験値が余っていれば連続レベルアップ
        };
        box.appendChild(div);
    });
    $('levelup-modal').style.display = 'flex';
}

// ============================
// ゲームオーバー
// ============================
function gameOver(mode) {
    if (mode === 'win') score += Math.round(5000 * ST().coin);
    state = 'over'; $('pause-screen').style.display = 'none';
    S.physics.pause(); Sound.stopBgm();
    joy.active = false; joy.x = joy.y = 0;
    const total = score + Math.floor(gameTime / 1000) * 5;
    const isNew = total > best;
    if (isNew) { best = total; saveNum('candySurvivorBest', best); }
    setText('best-start', best);
    const earned = Math.floor(total / 8 * ST().coin * stats.coinMul);
    coins += earned; saveNum('csCoins', coins); setText('coins-start', coins);
    $('go-result').innerHTML = '';
    [`SCORE: ${total}${isNew ? '  🎉 NEW RECORD!' : ''}`, `生存時間: ${fmtTime(gameTime)}`, `撃破数: ${stats.kills}　到達Lv: ${stats.lv}`, `BEST: ${best}`, `🍬 +${earned} コイン獲得！`]
        .forEach(t => { const d = document.createElement('div'); d.textContent = t; $('go-result').appendChild(d); });
    $('hud').style.display = 'none';
    $('go-title').textContent = mode === 'win' ? '🎉 STAGE CLEAR!' : mode === 'retire' ? 'RETIRE' : 'GAME OVER';
    $('go-title').style.color = mode === 'win' ? '#fff6a8' : '#ffb3d1';
    $('gameover-screen').style.display = 'flex';
}

// ============================
// ショップ（永続強化）
// ============================
function openShop() {
    renderShop();
    $('shop-screen').style.display = 'flex';
}
function closeShop() { $('shop-screen').style.display = 'none'; }
function renderShop() {
    setText('coins-shop', coins);
    const tabs = $('shop-tabs'); tabs.innerHTML = '';
    ['強化', '装備', 'ステージ', 'スキン'].forEach((n, k) => {
        const b = document.createElement('button'); b.textContent = n; b.className = 'tab' + (k === shopTab ? ' on' : '');
        b.onclick = () => { shopTab = k; renderShop(); }; tabs.appendChild(b);
    });
    const list = $('shop-list'); list.innerHTML = '';
    const row = (icon, name, sub, label, off, fn) => {
        const r = document.createElement('div'); r.className = 'shop-row';
        const mk = (tag, cls, txt, par = r) => { const d = document.createElement(tag); if (cls) d.className = cls; d.textContent = txt; par.appendChild(d); return d; };
        if (icon.startsWith('data:')) { const im = document.createElement('img'); im.src = icon; im.className = 'pv'; r.appendChild(im); } else mk('div', 'ic', icon);
        const tx = mk('div', 'tx', name); mk('small', '', sub, tx);
        const b = mk('button', '', label); b.disabled = off;
        b.onclick = () => { fn(); Sound.init(); Sound.gem(); renderShop(); refreshChip(); };
        list.appendChild(r);
    };
    const buy = (id, cost) => {
        if (owned(id) || coins < cost) return false;
        coins -= cost; saveNum('csO_' + id, 1); saveNum('csCoins', coins); setText('coins-start', coins); return true;
    };
    const tex = (key, fb) => { try { return S.textures.get(key).getSourceImage().toDataURL(); } catch (e) { return fb; } };
    if (shopTab === 0) PERKS.forEach(p => {
        const lv = perks[p.id], maxed = lv >= p.max, cost = Math.round(p.base * (lv + 1) * (1 + lv * 0.25));
        row(p.icon, p.name, `${p.text}　Lv ${lv}/${p.max}`, maxed ? 'MAX' : `🍬 ${cost}`, maxed || coins < cost, () => {
            if (coins < cost || maxed) return;
            coins -= cost; perks[p.id]++; saveNum('csCoins', coins); saveNum('csPerk_' + p.id, perks[p.id]); setText('coins-start', coins);
        });
    });
    else if (shopTab === 1) {
        WEAPS.forEach(([id, ic, nm, cost], k) => {
            const has = !cost || owned('w' + id), eq = sel.w === k;
            row(ic, '初期武器：' + nm, eq ? 'そうび中' : 'ゲーム開始時から持てる', eq ? 'そうび中' : has ? 'そうび' : `🍬 ${cost}`, eq || (!has && coins < cost),
                () => { if (!has && !buy('w' + id, cost)) return; sel.w = k; saveNum('csSelW', k); });
        });
        CHARMS.forEach((c, k) => {
            const has = owned(c.id), eq = sel.c === k + 1;
            row(c.icon, c.name, c.text, eq ? 'はずす' : has ? 'そうび' : `🍬 ${c.cost}`, !eq && !has && coins < c.cost,
                () => { if (eq) sel.c = 0; else { if (!has && !buy(c.id, c.cost)) return; sel.c = k + 1; } saveNum('csSelC', sel.c); });
        });
    } else if (shopTab === 2) STAGES.forEach((t, k) => {
        const has = !t.cost || owned('s' + k), eq = sel.st === k;
        row(tex('bg' + k, t.icon), t.name, t.text, eq ? 'えらび中' : has ? 'えらぶ' : `🍬 ${t.cost}`, eq || (!has && coins < t.cost),
            () => { if (!has && !buy('s' + k, t.cost)) return; sel.st = k; saveNum('csStage', k); });
    });
    else SKINS.forEach((t, k) => {
        const has = !t.cost || owned('k' + k), eq = sel.k === k;
        row(tex('p' + k, t.icon), t.name, 'スキン', eq ? 'きてる' : has ? 'きがえる' : `🍬 ${t.cost}`, eq || (!has && coins < t.cost),
            () => { if (!has && !buy('k' + k, t.cost)) return; sel.k = k; saveNum('csSkin', k); });
    });
}

// ============================
// HUD
// ============================
function fmtTime(ms) {
    const s = Math.floor(ms / 1000);
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
}

function updateHud() {
    const hp = Math.max(0, Math.ceil(stats.hp));
    setText('ui-hp', `${hp}/${stats.maxHp}`);
    setText('ui-lv', stats.lv);
    setText('ui-time', fmtTime(gameTime) + ' / 15:00');
    const pg = Math.min(100, gameTime / 9000).toFixed(1) + '%'; if (cache.pg !== pg) { cache.pg = pg; $('prog-fill').style.width = pg; }
    setText('ui-kills', stats.kills);
    setText('ui-score', score);
    const hpW = (hp / stats.maxHp * 100).toFixed(1) + '%';
    const exW = Math.min(100, stats.exp / stats.next * 100).toFixed(1) + '%';
    if (cache.hpw !== hpW) { cache.hpw = hpW; $('hp-fill').style.width = hpW; }
    if (cache.exw !== exW) { cache.exw = exW; $('exp-fill').style.width = exW; }
}

let toastTimer = null;
function toast(msg) {
    const t = $('toast');
    t.textContent = msg; t.style.opacity = 1;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { t.style.opacity = 0; }, 1800);
}
</script>
